# Optional LLM API configuration for free-text symptom translation (/parse-symptoms).
# Copy this file to `.env` (never commit `.env` to Git) and fill in ONE provider key.
# Without any API key, VitalAI automatically uses its built-in local clinical synonym parser.

# Option 1: Google Gemini (very cheap / free tier with gemini-2.5-flash)
GEMINI_API_KEY=

# Option 2: Groq (fast / cheap Llama models)
GROQ_API_KEY=

# Option 3: OpenAI (gpt-4o-mini) or any OpenAI-compatible base URL
OPENAI_API_KEY=
LLM_BASE_URL=
LLM_MODEL=
